# API Configuration
VITE_API_URL=http://localhost:8080

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PUBLIC_KEY=your_stripe_publishable_key_here
VITE_CHAPA_PUBLIC_KEY=your_chapa_public_key_here

# OAuth2 Configuration (Google)
# Get Google Client ID from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# OAuth2 Configuration (Apple)
# This is the Services ID (NOT the App/Bundle ID) from
# https://developer.apple.com/account/resources/identifiers
# The site's origin must be registered as a Domain and Return URL on that Services ID.
# Leave blank to hide the Apple button.
VITE_APPLE_CLIENT_ID=com.yourcompany.web

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics 4 (GA4) Configuration
# Get the Measurement ID from: https://analytics.google.com (Admin > Data Streams)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Other Configuration
VITE_APP_NAME=GeramiGifts
VITE_APP_VERSION=1.0.0 